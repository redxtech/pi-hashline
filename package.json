{
  "name": "pi-hashline",
  "version": "0.1.0",
  "private": true,
  "description": "Node-native base Pi port of oh-my-pi's hashline read/edit workflow",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "hashline"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "exports": {
    ".": "./src/hashline/index.ts",
    "./extension": "./src/extension.ts",
    "./prompt.md": "./src/hashline/prompt.md",
    "./grammar.lark": "./src/hashline/grammar.lark"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "xxhashjs": "0.2.2"
  },
  "optionalDependencies": {
    "@oh-my-pi/pi-natives-linux-x64": "17.2.12",
    "@oh-my-pi/pi-natives-linux-arm64": "17.2.12",
    "@oh-my-pi/pi-natives-darwin-x64": "17.2.12",
    "@oh-my-pi/pi-natives-darwin-arm64": "17.2.12",
    "@oh-my-pi/pi-natives-win32-x64": "17.2.12"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^24.0.0",
    "@types/xxhashjs": "^0.2.4",
    "typebox": "1.3.7",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
